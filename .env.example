# ============================================================
# POLARIS — The Winter Express
# Configuration template
# ============================================================
#
# This is a static HTML/CSS/JS site with no build step or
# backend, so this .env file is NOT loaded automatically at
# runtime. It exists as a single source of truth that lists
# every value a contributor must change before deploying.
#
# How to use:
#   1. Copy this file:           cp .env.example .env
#   2. Fill in your real values below.
#   3. Mirror those values into `index.html` by searching for
#      the placeholder names (e.g. YOUR_WHATSAPP_NUMBER) and
#      replacing each occurrence with your real value.
#
# Files matching `.env*` are ignored by git (see .gitignore),
# so your real values never leave your machine.

# ------------------------------------------------------------
# WhatsApp contact number
# ------------------------------------------------------------
# Used by:
#   - The "Inquire" button in the top-right nav
#   - The "Reserve your passage" CTA at the end of the scroll
#
# Format: international country code + number, with no plus
# sign, no spaces, no dashes. Examples:
#   Saudi Arabia: 966500000000
#   UAE:          971501234567
#   Egypt:        201001234567
#
WHATSAPP_NUMBER=YOUR_WHATSAPP_NUMBER

# ------------------------------------------------------------
# Optional — analytics / tracking (not currently wired up)
# ------------------------------------------------------------
# If you decide to add analytics later, set these and inject
# the tracking snippet into index.html accordingly.
#
# GA_MEASUREMENT_ID=
# META_PIXEL_ID=
# TIKTOK_PIXEL_ID=
